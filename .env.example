# Copy to .env and fill in. All EXPO_PUBLIC_* values are baked into the client bundle.

# Backend (optional; the app runs local-only without it)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Satellite imagery streamed onto the globe in terrain view. Defaults to EOX
# Sentinel-2 cloudless (free, no key). See README "Satellite imagery" for other
# providers. Set EXPO_PUBLIC_IMAGERY_TILES=off to keep the bundled texture only.
# EXPO_PUBLIC_IMAGERY_TILES=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg
# EXPO_PUBLIC_IMAGERY_MAX_ZOOM=14
# EXPO_PUBLIC_IMAGERY_TILE_SIZE=256
# EXPO_PUBLIC_IMAGERY_ATTRIBUTION=Sentinel-2 cloudless by EOX

# Shaded-relief tiles for the terrain view. Defaults to Esri World Terrain
# Base (free for non-commercial use with attribution). Same tile size as above.
# EXPO_PUBLIC_TERRAIN_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Terrain_Base/MapServer/tile/{z}/{y}/{x}
# EXPO_PUBLIC_TERRAIN_MAX_ZOOM=13
# EXPO_PUBLIC_TERRAIN_ATTRIBUTION=Esri, USGS, NOAA

# Course imagery for the live round map (needs to resolve greens: zoom 17+).
# Defaults to Esri World Imagery, free for non-commercial use with attribution.
# EXPO_PUBLIC_COURSE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# EXPO_PUBLIC_COURSE_MAX_ZOOM=19
# EXPO_PUBLIC_COURSE_TILE_SIZE=256
# EXPO_PUBLIC_COURSE_ATTRIBUTION=Esri, Maxar, Earthstar Geographics
