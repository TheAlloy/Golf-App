# Copy to .env and fill in. All EXPO_PUBLIC_* values are baked into the client bundle.

# Backend (optional; the app runs local-only without it)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Satellite imagery streamed onto the globe in terrain view. Defaults to EOX
# Sentinel-2 cloudless (free, no key). See README "Satellite imagery" for other
# providers. Set EXPO_PUBLIC_IMAGERY_TILES=off to keep the bundled texture only.
# EXPO_PUBLIC_IMAGERY_TILES=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg
# EXPO_PUBLIC_IMAGERY_MAX_ZOOM=14
# EXPO_PUBLIC_IMAGERY_TILE_SIZE=256
# EXPO_PUBLIC_IMAGERY_ATTRIBUTION=Sentinel-2 cloudless by EOX
