# Copy to .env and fill in. All EXPO_PUBLIC_* values are baked into the client bundle.

# Backend (optional; the app runs local-only without it)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Streamed map tiles. Defaults are keyless and free with attribution: Esri
# World Imagery for the terrain view, CARTO Dark Matter for the map view.
# See README "Streamed map tiles" for other providers. Set a _TILES value to
# "off" to disable streaming for that view.
# EXPO_PUBLIC_IMAGERY_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# EXPO_PUBLIC_IMAGERY_MAX_ZOOM=19
# EXPO_PUBLIC_IMAGERY_TILE_SIZE=256
# EXPO_PUBLIC_IMAGERY_ATTRIBUTION=Esri, Maxar, Earthstar Geographics
# EXPO_PUBLIC_BASEMAP_TILES=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
# EXPO_PUBLIC_BASEMAP_MAX_ZOOM=20
# EXPO_PUBLIC_BASEMAP_TILE_SIZE=256
# EXPO_PUBLIC_BASEMAP_ATTRIBUTION=OpenStreetMap contributors, CARTO
